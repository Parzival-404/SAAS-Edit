# ---- Database ----
DATABASE_URL="postgresql://saasedit:saasedit@localhost:5432/saasedit"

# ---- Redis / Queue ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (NextAuth) ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ---- Object storage (S3-compatible, e.g. Cloudflare R2) ----
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="saas-edit-clips"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL="https://pub-xxxxx.r2.dev"

# ---- YouTube Data API v3 (clé API publique, pas d'OAuth requis pour
# surveiller une chaîne publique) ----
YOUTUBE_API_KEY=""

# ---- AI providers ----
ANTHROPIC_API_KEY=""
# Whisper transcription: choose one
OPENAI_API_KEY=""
WHISPER_MODE="api" # "api" (OpenAI Whisper API) | "local" (faster-whisper in worker container)

# ---- Web app URL (used by worker to notify status, if needed) ----
WEB_APP_URL="http://localhost:3000"
