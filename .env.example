# ---- Database ----
DATABASE_URL="postgresql://saasedit:saasedit@localhost:5432/saasedit"

# ---- Redis / Queue ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (NextAuth) ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ---- Chiffrement des tokens OAuth des comptes sociaux connectés ----
ENCRYPTION_KEY="change-me-generate-with-openssl-rand-base64-32"

# ---- Object storage (S3-compatible, e.g. Cloudflare R2) ----
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="saas-edit-clips"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL="https://pub-xxxxx.r2.dev"

# ---- YouTube Data API v3 (clé API publique, pas d'OAuth requis pour
# surveiller une chaîne publique) ----
YOUTUBE_API_KEY=""

# ---- AI providers ----
ANTHROPIC_API_KEY=""
# Whisper transcription: choose one
OPENAI_API_KEY=""
WHISPER_MODE="api" # "api" (OpenAI Whisper API) | "local" (faster-whisper in worker container)

# Recadrage 9:16 intelligent (suivi de visage). Nécessite python3 +
# apps/worker/scripts/requirements.txt installés dans l'image worker.
# Repli automatique sur un crop centré statique si indisponible.
SMART_CROP_ENABLED="true"

# ---- Worker : réglages avancés (valeurs par défaut raisonnables, à ne
# modifier que si besoin) ----
# Dossier de travail temporaire (téléchargement, montage) — nettoyé après
# chaque vidéo traitée.
WORKER_TMP_DIR="/tmp/saas-edit"
# Fréquence (ms) à laquelle le worker vérifie quelles chaînes connectées
# sont dues pour un contrôle (indépendante de la fréquence par chaîne,
# configurable par l'utilisateur dans l'onglet "Chaînes").
CHANNEL_MONITOR_TICK_MS="300000"

# ---- Publication (V3) ----
# Fréquence (ms) à laquelle le worker vérifie les posts programmés dus.
PUBLISH_SCHEDULER_TICK_MS="60000"

# ---- Analytics et commentaires (V4) ----
# Fréquence (ms) du tick de vérification des relevés analytics dus.
ANALYTICS_TICK_MS="900000"
# Intervalle minimum (ms) entre deux relevés de métriques pour un même post.
ANALYTICS_REFRESH_INTERVAL_MS="3600000"
# Nombre max de commentaires récupérés par analyse.
COMMENT_ANALYSIS_MAX_COMMENTS="100"
