// SAAS-Edit — schéma de base de données
//
// V1 (MVP) : utilisateur -> vidéo source -> job de traitement -> clips ->
// bibliothèque, en mode manuel uniquement.
// V2 : chaînes YouTube connectées + surveillance automatique (détection des
// nouvelles vidéos, déclenchement auto du pipeline).
// Publication et analytics arriveront aux phases suivantes (voir README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings         UserSettings?
  sourceVideos     SourceVideo[]
  clips            Clip[]
  inspirationItems InspirationItem[]
  youtubeChannels  YoutubeChannel[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  minClipsPerVideo    Int     @default(3)
  maxClipsPerVideo    Int     @default(8)
  targetClipDurationS Int     @default(45)
  tone                Tone    @default(VIRAL)
  subtitleLanguage    String  @default("fr")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Tone {
  FUNNY
  PROFESSIONAL
  VIRAL
  DRAMA
  EDUCATIONAL
}

model SourceVideo {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  source         VideoSource     @default(MANUAL)
  channelId      String?
  channel        YoutubeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  youtubeUrl     String
  youtubeVideoId String
  title          String?
  description    String?  @db.Text
  durationSec    Int?
  thumbnailUrl   String?
  publishedAt    DateTime?
  viewCount      Int?
  likeCount      Int?

  status         VideoStatus @default(PENDING)
  errorMessage   String?     @db.Text

  transcript     Transcript?
  clips          Clip[]
  processingJobs ProcessingJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([youtubeVideoId])
  @@index([channelId])
}

enum VideoStatus {
  PENDING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  EDITING
  EXPORTING
  READY
  FAILED
}

enum VideoSource {
  MANUAL
  CHANNEL_MONITOR
}

model YoutubeChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId    String
  handle       String?
  title        String?
  thumbnailUrl String?

  monitoringEnabled     Boolean   @default(true)
  checkFrequencyMinutes Int       @default(30)
  lastCheckedAt         DateTime?
  // Date de publication de la dernière vidéo déjà détectée, pour ne
  // récupérer que les nouveautés lors du prochain sondage.
  lastSeenPublishedAt   DateTime?
  errorMessage          String?   @db.Text

  sourceVideos SourceVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([userId])
}

model ProcessingJob {
  id            String      @id @default(cuid())
  sourceVideoId String
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)

  status      VideoStatus @default(PENDING)
  progress    Int         @default(0) // 0-100
  errorMessage String?    @db.Text

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([sourceVideoId])
}

model Transcript {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)

  language String
  fullText String @db.Text
  // Segments horodatés (mot ou phrase) : [{ start, end, text }]
  segments Json

  createdAt DateTime @default(now())
}

model Clip {
  id            String      @id @default(cuid())
  sourceVideoId String
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  startSec    Float
  endSec      Float
  durationSec Float

  title       String
  hook        String  @db.Text
  description String  @db.Text
  hashtags    String[]
  captionText String?  @db.Text

  viralScore  Float?  // 0-1, potentiel viral estimé par le LLM
  scoreReason String? @db.Text

  status       ClipStatus @default(QUEUED)
  videoUrl     String?
  thumbnailUrl String?
  errorMessage String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceVideoId])
  @@index([userId])
}

enum ClipStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

model InspirationItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    InspirationType
  content String          @db.Text
  notes   String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum InspirationType {
  HOOK
  TITLE
  FORMAT
  REFERENCE
  TONE_GUIDELINE
  WORD_TO_AVOID
  TEMPLATE
  BRAND_PREFERENCE
}
