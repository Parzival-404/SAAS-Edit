// SAAS-Edit — schéma de base de données
//
// V1 (MVP) : utilisateur -> vidéo source -> job de traitement -> clips ->
// bibliothèque, en mode manuel uniquement.
// V2 : chaînes YouTube connectées + surveillance automatique (détection des
// nouvelles vidéos, déclenchement auto du pipeline).
// V3 : comptes sociaux connectés + publication (programmée ou automatique,
// avec validation manuelle optionnelle).
// Analytics arriveront à la phase suivante (voir README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings         UserSettings?
  sourceVideos     SourceVideo[]
  clips            Clip[]
  inspirationItems InspirationItem[]
  youtubeChannels  YoutubeChannel[]
  socialAccounts   SocialAccount[]
  scheduledPosts   ScheduledPost[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  minClipsPerVideo    Int     @default(3)
  maxClipsPerVideo    Int     @default(8)
  targetClipDurationS Int     @default(45)
  tone                Tone    @default(VIRAL)
  subtitleLanguage    String  @default("fr")

  // MANUAL_VALIDATION : chaque post reste en brouillon jusqu'à validation
  // explicite. AUTOMATIC : publié/programmé sans intervention dès que le
  // clip est prêt (uniquement si un compte social est connecté).
  publishMode PublishMode @default(MANUAL_VALIDATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PublishMode {
  MANUAL_VALIDATION
  AUTOMATIC
}

enum Tone {
  FUNNY
  PROFESSIONAL
  VIRAL
  DRAMA
  EDUCATIONAL
}

model SourceVideo {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  source         VideoSource     @default(MANUAL)
  channelId      String?
  channel        YoutubeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  youtubeUrl     String
  youtubeVideoId String
  title          String?
  description    String?  @db.Text
  durationSec    Int?
  thumbnailUrl   String?
  publishedAt    DateTime?
  viewCount      Int?
  likeCount      Int?

  status         VideoStatus @default(PENDING)
  errorMessage   String?     @db.Text

  transcript     Transcript?
  clips          Clip[]
  processingJobs ProcessingJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([youtubeVideoId])
  @@index([channelId])
}

enum VideoStatus {
  PENDING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  EDITING
  EXPORTING
  READY
  FAILED
}

enum VideoSource {
  MANUAL
  CHANNEL_MONITOR
}

model YoutubeChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId    String
  handle       String?
  title        String?
  thumbnailUrl String?

  monitoringEnabled     Boolean   @default(true)
  checkFrequencyMinutes Int       @default(30)
  lastCheckedAt         DateTime?
  // Date de publication de la dernière vidéo déjà détectée, pour ne
  // récupérer que les nouveautés lors du prochain sondage.
  lastSeenPublishedAt   DateTime?
  errorMessage          String?   @db.Text

  sourceVideos SourceVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([userId])
}

model ProcessingJob {
  id            String      @id @default(cuid())
  sourceVideoId String
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)

  status      VideoStatus @default(PENDING)
  progress    Int         @default(0) // 0-100
  errorMessage String?    @db.Text

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([sourceVideoId])
}

model Transcript {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)

  language String
  fullText String @db.Text
  // Segments horodatés (mot ou phrase) : [{ start, end, text }]
  segments Json

  createdAt DateTime @default(now())
}

model Clip {
  id            String      @id @default(cuid())
  sourceVideoId String
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  startSec    Float
  endSec      Float
  durationSec Float

  title       String
  hook        String  @db.Text
  description String  @db.Text
  hashtags    String[]
  captionText String?  @db.Text

  // Autres propositions de titre/hook générées par le LLM, pour
  // permettre à l'utilisateur de comparer/choisir avant publication.
  titleVariants String[]
  hookVariants  String[]

  viralScore  Float?  // 0-1, potentiel viral estimé par le LLM
  scoreReason String? @db.Text

  status       ClipStatus @default(QUEUED)
  videoUrl     String?
  thumbnailUrl String?
  errorMessage String?    @db.Text

  scheduledPosts ScheduledPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceVideoId])
  @@index([userId])
}

enum ClipStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

model InspirationItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    InspirationType
  content String          @db.Text
  notes   String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum InspirationType {
  HOOK
  TITLE
  FORMAT
  REFERENCE
  TONE_GUIDELINE
  WORD_TO_AVOID
  TEMPLATE
  BRAND_PREFERENCE
}

model SocialAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform    SocialPlatform
  displayName String
  // Identifiant du compte côté plateforme (utile pour l'API de publication
  // et pour détecter une reconnexion du même compte).
  externalAccountId String?

  // Chiffrés (AES-256-GCM, voir apps/web/src/lib/crypto.ts) avant stockage
  // — jamais en clair en base.
  accessTokenEncrypted  String? @db.Text
  refreshTokenEncrypted String? @db.Text
  tokenExpiresAt        DateTime?

  status       SocialAccountStatus @default(CONNECTED)
  errorMessage String?             @db.Text

  scheduledPosts ScheduledPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

enum SocialPlatform {
  TIKTOK
  INSTAGRAM_REELS
  YOUTUBE_SHORTS
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  ERROR
}

model ScheduledPost {
  id     String @id @default(cuid())
  clipId String
  clip   Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform        SocialPlatform

  caption  String   @db.Text
  hashtags String[]

  status       PostStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?

  platformPostId  String?
  platformPostUrl String?
  errorMessage    String? @db.Text

  metricsSnapshots PostMetricsSnapshot[]
  commentInsight   CommentInsight?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clipId])
  @@index([userId])
  @@index([socialAccountId])
  @@index([status, scheduledFor])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// Un relevé par appel du worker (voir analyticsScheduler.ts) : permet de
// tracer l'évolution des performances dans le temps, pas juste un
// instantané figé.
model PostMetricsSnapshot {
  id              String        @id @default(cuid())
  scheduledPostId String
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  capturedAt DateTime @default(now())

  views    Int?
  likes    Int?
  comments Int?
  shares   Int?
  // (likes+comments+shares)/views — null si views absent/nul.
  engagementRate Float?

  createdAt DateTime @default(now())

  @@index([scheduledPostId, capturedAt])
}

// Une analyse par post (régénérée à chaque exécution) : résumé des
// réactions, sentiment, questions fréquentes, idées de futurs clips.
model CommentInsight {
  id              String        @id @default(cuid())
  scheduledPostId String        @unique
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  summary  String @db.Text
  positiveCount Int @default(0)
  negativeCount Int @default(0)
  neutralCount  Int @default(0)

  topThemes    String[]
  faqs         String[]
  contentIdeas String[]

  commentsAnalyzed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
